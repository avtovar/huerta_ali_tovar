# Copiá este archivo como .env y completá con los datos de tu proyecto Firebase
# (Consola Firebase > Configuración del proyecto > Tus apps > Configuración SDK).
# Estos valores NO son secretos (identifican el proyecto), pero igual no se suben: .env está en .gitignore.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
